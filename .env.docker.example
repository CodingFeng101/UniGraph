ENVIRONMENT=dev
TZ=Asia/Shanghai

MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_DATABASE=onlineunigraph
MYSQL_EXPOSE_PORT=3306

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0
REDIS_EXPOSE_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=8080

TOKEN_SECRET_KEY=replace-with-a-random-token-secret
OPERA_LOG_ENCRYPT_SECRET_KEY=replace-with-a-random-opera-log-secret
JXNU_AES_SECRET_KEY=

OAUTH2_GITHUB_CLIENT_ID=test
OAUTH2_GITHUB_CLIENT_SECRET=test
OAUTH2_LINUX_DO_CLIENT_ID=test
OAUTH2_LINUX_DO_CLIENT_SECRET=test

CELERY_BROKER_REDIS_DATABASE=1
CELERY_BACKEND_REDIS_DATABASE=2

EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=replace-with-your-embedding-api-key

SSO_USER_INFO_URL=http://backend:8000/knowg/v1/sys/users/me
INDEX_EXPORT_URL_ROOT=http://backend:8000/knowg/v1/knowledge/ask
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]

FRONTEND_VITE_HOST_URL=
FRONTEND_VITE_API_BASE_URL=/knowg
FRONTEND_VITE_SHOW_IMAGE_API=/knowg/v1/image/
FRONTEND_VITE_USER_INFO_SSO_URL=/knowg/v1/sys/users/me

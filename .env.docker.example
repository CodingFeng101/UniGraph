ENVIRONMENT=dev
TZ=Asia/Shanghai

MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_DATABASE=onlineunigraph
MYSQL_EXPOSE_PORT=3306
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_TIMEOUT=30

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0
REDIS_EXPOSE_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=8080

TOKEN_SECRET_KEY=replace-with-a-random-token-secret
# Valid development-only Base64 key; production validation rejects the embedded "changeme" marker.
AUTH_AES_SECRET_KEY=changemeAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LLM_API_KEY_ENCRYPTION_KEY=replace-with-a-long-random-secret
OPERA_LOG_ENCRYPT_SECRET_KEY=replace-with-a-random-opera-log-secret
JXNU_AES_SECRET_KEY=
JXNU_USER_INFO_URL=https://ai.jxselab.com/tsp/v1/sys/users/me

OAUTH2_GITHUB_CLIENT_ID=test
OAUTH2_GITHUB_CLIENT_SECRET=test
OAUTH2_LINUX_DO_CLIENT_ID=test
OAUTH2_LINUX_DO_CLIENT_SECRET=test

# QQ SMTP（MAIL_PASSWORD 填 QQ 邮箱授权码，不是 QQ 登录密码）
MAIL_USERNAME=your-qq-number@qq.com
MAIL_PASSWORD=your-qq-smtp-authorization-code
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_FROM_NAME=UniGraph

CELERY_BROKER_REDIS_DATABASE=1
CELERY_BACKEND_REDIS_DATABASE=2
CELERY_DEFAULT_CONCURRENCY=4
CELERY_QA_CONCURRENCY=8
CELERY_INDEXING_CONCURRENCY=2
CELERY_MIGRATION_CONCURRENCY=2

EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=replace-with-your-embedding-api-key

INDEX_EXPORT_URL_ROOT=http://backend:8000/knowg/v1/knowledge/ask
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]

CHAT_CONTEXT_RECENT_TURNS=8
CHAT_CONTEXT_COMPRESSION_THRESHOLD_TOKENS=6000
CHAT_CONTEXT_TRIGGER_RATIO=0.7
CHAT_CONTEXT_SUMMARY_MAX_TOKENS=1500
CHAT_CONTEXT_DEFAULT_MODEL_LIMIT=128000
CHAT_CONTEXT_MODEL_LIMITS={"gpt-5":400000,"gpt-4.1":1000000,"gpt-4o":128000,"o1":200000,"o3":200000,"claude":200000,"deepseek":128000,"gemini":1000000}
LLM_MAX_CONCURRENCY=8
LLM_HTTP_MAX_CLIENTS=32
LLM_HTTP_MAX_CONNECTIONS=100
LLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
LLM_HTTP_CONNECT_TIMEOUT=10
LLM_HTTP_READ_TIMEOUT=600
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_CONCURRENCY=4
ALLOW_PRIVATE_LLM_ENDPOINTS=false
ENABLE_PUBLIC_PASSWORD_RESET=false
COOKIE_SECURE=false

FRONTEND_VITE_HOST_URL=
FRONTEND_VITE_API_BASE_URL=/knowg
FRONTEND_VITE_SHOW_IMAGE_API=/knowg/v1/image/
FRONTEND_VITE_USER_INFO_SSO_URL=/knowg/v1/sys/users/me

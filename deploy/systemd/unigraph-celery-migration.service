[Unit]
Description=UniGraph knowledge migration Celery worker
After=network-online.target mysql.service redis-server.service unigraph-backend.service
Wants=network-online.target

[Service]
Type=simple
User=unigraph
Group=unigraph
WorkingDirectory=/opt/unigraph
EnvironmentFile=/etc/unigraph/unigraph.env
ExecStart=/opt/unigraph/.venv/bin/celery -A backend.app.task.celery:celery_app worker --queues=migration --concurrency=${CELERY_MIGRATION_CONCURRENCY} --loglevel=info
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
